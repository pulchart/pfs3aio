# Build setdeldir, setfnsize and setlargefile with one gcc toolchain, one set
# per tier.
#
#   make -C tools -f makefile.gcc [OUTDIR=dir] [AMIGA_PREFIX=/path]
#
# Driven by ../GNUmakefile with the tiers of PROGRAM_TIERS in ../tiers.mk.
# ./makefile is upstream's single build.

.DEFAULT_GOAL := all

AMIGA_PREFIX ?= $(firstword $(wildcard $(HOME)/opt/m68k-amigaos /opt/amiga))
ifeq ($(origin CC),default)
CC := $(AMIGA_PREFIX)/bin/m68k-amigaos-gcc
endif

CPPFLAGS = -I.
LIBS = -lamiga -lgcc -lnix13 -lnix -s

CFLAGS_COMMON = -Os -fbbb=+ -noixemul -fomit-frame-pointer -mregparm=3 -msmall-code -s $(EXTRA_CFLAGS)

include ../tiers.mk
TIERS = $(PROGRAM_TIERS)

OUTDIR = build
OBJDIR = $(OUTDIR)/obj

TOOLS = setdeldir setfnsize setlargefile
HEADERS = versions.h ../pfsbuild.h

include ../version.mk

define TIER_RULES
CFLAGS_$(1) = $$(CFLAGS_COMMON) $$(TIER_CFLAGS_$(1)) $$(TIER_TAG_$(1))
OUTDIR_$(1) = $$(OUTDIR)/$(1)
OBJDIR_$(1) = $$(OBJDIR)/$(1)
ASMDIR_$(1) = $$(OUTDIR)/asm/$(1)
TARGETS_$(1) = $$(addprefix $$(OUTDIR_$(1))/,$$(TOOLS))
ASMS_$(1) = $$(addprefix $$(ASMDIR_$(1))/,$$(addsuffix .s,$$(TOOLS)))

$$(OUTDIR_$(1))/%: $$(OBJDIR_$(1))/%.o | $$(OUTDIR_$(1))
	$$(CC) -o $$@ $$< $$(CFLAGS_$(1)) $$(LIBS)

$$(OBJDIR_$(1))/%.o: %.c $$(HEADERS) $$(ORIGINSTAMP) | $$(OBJDIR_$(1))
	$$(CC) $$(CFLAGS_$(1)) $$(CPPFLAGS) -c -o $$@ $$<

$$(ASMDIR_$(1))/%.s: %.c $$(HEADERS) $$(ORIGINSTAMP) | $$(ASMDIR_$(1))
	$$(CC) $$(CFLAGS_$(1)) $$(CPPFLAGS) -S -o $$@ $$<

$$(OBJDIR_$(1))/setdeldir.o $$(ASMDIR_$(1))/setdeldir.s: ../blocks.h

$$(OUTDIR_$(1)) $$(OBJDIR_$(1)) $$(ASMDIR_$(1)):
	mkdir -p $$@
endef

$(foreach t,$(TIERS),$(eval $(call TIER_RULES,$(t))))

.PHONY: all asm clean check-cc

all: check-cc $(foreach t,$(TIERS),$(TARGETS_$(t)))

# Assembly for the 68060 audit, with the flags of the objects.
asm: check-cc $(foreach t,$(TIERS),$(ASMS_$(t)))

check-cc:
	@command -v $(CC) >/dev/null || { echo "ERROR: compiler not found: $(CC)"; exit 1; }

clean:
	rm -rf $(OUTDIR)
